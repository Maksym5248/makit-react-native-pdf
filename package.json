{
  "name": "@makit-kit/react-native-pdf",
  "version": "0.1.0",
  "description": "Local-file PDF reader for React Native and Web",
  "license": "MIT",
  "main": "lib/module/index.js",
  "react-native": "src/index.ts",
  "types": "lib/types/index.d.ts",
  "peerDependencies": {
    "expo": ">=55",
    "pdfjs-dist": "4.8.69",
    "react": ">=19",
    "react-native": ">=0.83",
    "react-pdf": "9.2.1"
  },
  "peerDependenciesMeta": {
    "react-pdf": {
      "optional": true
    },
    "pdfjs-dist": {
      "optional": true
    },
    "expo": {
      "optional": true
    }
  },
  "codegenConfig": {
    "name": "ammopdf",
    "type": "all",
    "jsSrcsDir": "src/native",
    "android": {
      "javaPackageName": "org.ammo.pdf"
    },
    "ios": {
      "componentProvider": {
        "AmmoPDFPdfView": "AmmoPDFPdfView"
      },
      "modulesProvider": {
        "AmmoPdfSearch": "AmmoPdfSearch"
      }
    }
  },
  "scripts": {
    "test": "jest --config jest.config.cjs --runInBand",
    "test:ios-geometry": "node test/ios-geometry.cjs",
    "typecheck": "tsc -p tsconfig.json",
    "test:web-build": "node test/web-build.cjs",
    "lint": "eslint src --ext .ts,.tsx",
    "build": "node scripts/build.cjs",
    "prepack": "npm run build",
    "test:expo": "node --test test/expo-plugin.cjs",
    "build:site": "node scripts/build-site.cjs",
    "web": "npm run web --workspace pdf-reader-example",
    "patch:web": "node scripts/apply-web-patches.cjs",
    "typecheck:example": "npm run typecheck --workspace pdf-reader-example",
    "typecheck:expo": "tsc -p example-expo/tsconfig.json",
    "test:package": "node --test test/package.cjs",
    "test:patches": "node --test test/web-patches.cjs"
  },
  "module": "lib/module/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "react-native": "./src/index.ts",
      "browser": "./lib/module/index.web.js",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json",
    "./app.plugin.js": "./app.plugin.js"
  },
  "files": [
    "src",
    "lib",
    "android/src",
    "android/build.gradle",
    "android/consumer-rules.pro",
    "ios",
    "LocalPdfReader.podspec",
    "README.md",
    "LICENSE",
    "NOTICE",
    "docs",
    "app.plugin.js",
    "patches",
    "scripts/apply-web-patches.cjs"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Maksym5248/makit-react-native-pdf.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19.4"
  },
  "keywords": [
    "react-native",
    "pdf",
    "local",
    "search",
    "highlight",
    "jsi",
    "expo",
    "pdfkit",
    "pdfium",
    "offline",
    "web"
  ],
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-transform-flow-strip-types": "7.27.1",
    "@babel/preset-env": "^7.25.3",
    "@babel/preset-react": "^7.18.6",
    "@babel/preset-typescript": "^7.28.5",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native/babel-preset": "0.83.1",
    "@react-native/eslint-config": "0.83.1",
    "@react-native/metro-config": "0.83.1",
    "@react-native/typescript-config": "0.83.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-jest": "^29.7.0",
    "babel-loader": "^9.1.3",
    "css-loader": "^6.0.0",
    "eslint": "^8.19.0",
    "expo": "~55.0.32",
    "expo-build-properties": "~55.0.18",
    "html-webpack-plugin": "^5.6.0",
    "jest": "^29.6.3",
    "jest-environment-jsdom": "^29.7.0",
    "marked": "^15.0.12",
    "pdfjs-dist": "4.8.69",
    "playwright": "1.58.2",
    "prettier": "2.8.8",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-web": "^0.21.2",
    "react-pdf": "9.2.1",
    "react-test-renderer": "19.2.0",
    "style-loader": "^3.0.0",
    "typescript": "~5.9.2",
    "webpack": "^5",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  },
  "workspaces": [
    "example",
    "example-expo"
  ],
  "homepage": "https://maksym5248.github.io/makit-react-native-pdf/",
  "bugs": {
    "url": "https://github.com/Maksym5248/makit-react-native-pdf/issues"
  }
}
